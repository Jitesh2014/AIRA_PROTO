{
  "name": "aira-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "docker start piston_api 2>nul || docker run --privileged -p 2000:2000 -v D:/RAG-UI-main/piston/packages:/piston/packages --name piston_api ghcr.io/engineer-man/piston -d",
    "dev": "tsx watch src/index.ts",
    "prestart": "docker start piston_api 2>nul || docker run --privileged -p 2000:2000 -v D:/RAG-UI-main/piston/packages:/piston/packages --name piston_api ghcr.io/engineer-man/piston -d",
    "start": "tsx src/index.ts",
    "piston:start": "docker start piston_api",
    "piston:stop": "docker stop piston_api",
    "piston:status": "docker ps --filter name=piston_api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2"
  }
  
}
