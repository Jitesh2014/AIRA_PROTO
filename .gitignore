# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==========================================
# 1. ENVIRONMENT VARIABLES & SECRETS
# ==========================================
# Ignore all .env files everywhere in the project
.env
.env.*
*.env

# Allow example/template files (these should NOT contain real secrets)
!.env.local.example
!server/.env.example
!rag-service/.env.example

# ==========================================
# 2. DEPENDENCIES
# ==========================================
# Node.js
/node_modules
/server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python
.venv/
venv/
rag-service/.venv/
backend/.venv/
__pycache__/
rag-service/__pycache__/
rag-service/**/__pycache__/
backend/__pycache__/
backend/**/__pycache__/

# ==========================================
# 3. FRAMEWORKS & BUILDS
# ==========================================
# Next.js
/.next/
/out/
next-env.d.ts

# Production Builds
/build
/server/dist/
*.tsbuildinfo

# ==========================================
# 4. TESTING & COVERAGE
# ==========================================
/coverage

# ==========================================
# 5. DATABASES & LOCAL STORAGE
# ==========================================
# Local SQLite databases
backend/aira.db
*.sqlite
*.sqlite3

# Uploads (files uploaded by users during local testing)
/server/uploads/
/uploads/

# ==========================================
# 6. LOGS & DEBUGGING
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ==========================================
# 7. OS & IDE FILES
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ==========================================
# 8. VERCEL & MISC
# ==========================================
.vercel
*.pem


.aira-full.env
